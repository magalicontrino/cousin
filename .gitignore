.DS_Store

Font /

# Les maquettes de design (exports DesignSync) — références de travail, pas du site
maquettes/

# ⚠ Les documents dont le droit de REDIFFUSION n'est pas vérifié.
# Les fichiers du dépôt sont servis par une adresse PUBLIQUE : la connexion Google
# protège l'app, pas le dossier. Un support de formation remis à des participants
# n'est pas un document public. Tant que l'éditeur n'a pas dit oui, il reste ici.
documents/a-verifier/

# La configuration locale de l'atelier (permissions, serveur d'essai) : elle
# décrit CET ordinateur, pas le site. Elle n'a rien à faire dans le dépôt.
.claude/

# Les images de programmes envoyées par les assos (sources de saisie, pas des
# livrables) : on encode ce qu'elles disent dans la base, l'image reste locale.
# Si un jour on veut en afficher une dans l'app, il faudra le décider — et alors
# elle sortira de cette liste.
activité/

# ═══ LES EXPORTS DE CLAUDE DESIGN (retirés le 22/09/2026) ═══
# Sept dossiers de maquettes livrées, 34 Mo, que rien dans le site n'appelle. Ils
# alourdissaient chaque publication sans jamais être servis à personne.
# ⚠ ILS SONT TOUJOURS SUR SON ORDINATEUR, dans le dossier du projet : ils ne sont
#   simplement plus suivis par git, donc plus publiés. Et toutes leurs versions
#   restent dans l'historique — `git log --all -- "claudedesign parcs"` les retrouve.
claudedesign */
ecran lux/
